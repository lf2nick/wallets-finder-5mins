# wallets-finder-5mins — copy to .env and fill in

# DB 連線（指向 poly-tracker 共用的 crypto-db postgres）
# 本機開發：DB_HOST=host.docker.internal DB_PORT=5433
# EC2: docker compose ec2 override 會把 DB_HOST 改成 crypto-db (內部 :5432)
DB_HOST=host.docker.internal
DB_PORT=5433
DB_USER=ming
DB_PASSWORD=
DB_NAME=poly_tracker

# Backend HTTP listen address (容器內)
HTTP_ADDR=:8080

# Dashboard 密碼（Bearer token）— 空字串 = 不啟用密碼保護
DASHBOARD_TOKEN=
